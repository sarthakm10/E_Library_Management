# Normalise line endings in the repo; check out with the platform's default.
* text=auto

# Shell scripts must keep LF so they run on macOS/Linux; Windows scripts keep CRLF.
*.sh   text eol=lf
mvnw   text eol=lf
*.cmd  text eol=crlf

# Images are binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
